liquibase-rollback.sh
#!/bin/sh
set -euo pipefail

echo
echo
echo "============================================================================================================================="
echo "============================================     Starting liquibase-rollback.sh      ============================================="
echo "============================================================================================================================="
echo

ENV_ARG=${1:-}
if [ -n "$ENV_ARG" ]; then
  ENVIRONMENT="$ENV_ARG"
else
  ENVIRONMENT=${ENVIRONMENT:-}
fi

if [ -z "$ENVIRONMENT" ]; then
  echo "❌ ERROR: ENVIRONMENT required"
  exit 1
fi

if [ -z "$ROLLBACK_TAG" ]; then
  echo "❌ ERROR: ROLLBACK_TAG required"
  exit 1
fi


ENV_LOWER=$(printf '%s' "$ENVIRONMENT" | awk '{print tolower($0)}')

: "${DB_URL:?Missing DB_URL}"
: "${DB_USER:?Missing DB_USER}"
: "${DB_PASS:?Missing DB_PASS}"
: "${DB_IP_UNDERSCORE:?Missing DB_IP_UNDERSCORE}"

CHANGELOG_DIR="/liquibase/databases/${ENV_LOWER}/${ENV_LOWER}_${DB_IP_UNDERSCORE}"
CHANGELOG_FILE="changelog.xml"

if [ ! -f "$CHANGELOG_DIR/$CHANGELOG_FILE" ]; then
  echo "❌ ERROR: Changelog missing: $CHANGELOG_DIR/$CHANGELOG_FILE"
  exit 1
fi

echo "✅ [INFO] Changelog directory: $CHANGELOG_DIR"
echo "✅ [INFO] Changelog file: $CHANGELOG_FILE"



# Locate liquibase binary
echo "✅ [DEBUG] Searching for liquibase binary in container..."
LIQUIBASE_BIN=$(command -v liquibase || find / -type f -name liquibase 2>/dev/null | head -n 1 || true)

if [ -z "$LIQUIBASE_BIN" ]; then
  echo "❌ [ERROR] Liquibase binary not found in container!"
  exit 1
fi

echo "✅ [INFO] Found liquibase binary at: $LIQUIBASE_BIN"

# Patch Liquibase wrapper script (to use sh)
echo "✅ [INFO] Patching Liquibase binary to use sh instead of bash..."
sed -i 's|#!/bin/bash|#!/bin/sh|' "$LIQUIBASE_BIN"
sed -i 's|env bash|env sh|g' "$LIQUIBASE_BIN"
sed -i 's| bash | sh |g' "$LIQUIBASE_BIN"

# Check version (optional)
echo "✅ [INFO] Liquibase version:"
"$LIQUIBASE_BIN" --version || echo "[WARN] Could not get liquibase version"

# Check required DB environment variables early
: "${DB_URL:?Missing DB_URL environment variable}"
: "${DB_USER:?Missing DB_USER environment variable}"
: "${DB_PASS:?Missing DB_PASS environment variable}"
echo
echo
echo
echo "User Paased Environment Variables through GoCD Pipeline: execution in liquibase-rollback.sh"
echo "✅ [INFO] DB Username: $DB_USER"
echo "✅ [INFO] DB URL: $DB_URL"
echo "✅ [INFO] CHANGEREQUEST_ID: $CHANGEREQUEST_ID"
echo "✅ [INFO] ROLLBACK_TAG: $ROLLBACK_TAG"

# Change directory to changelog directory so relative path works
cd "$CHANGELOG_DIR" || {
  echo "❌ [ERROR] Failed to change directory to $CHANGELOG_DIR"
  exit 1
}
echo
echo "📜 ------------------------------------------------------------->> History before rollback"
echo
"$LIQUIBASE_BIN" \
  --driver=oracle.jdbc.OracleDriver \
  --url="$DB_URL" \
  --username="$DB_USER" \
  --password="$DB_PASS" \
  --changeLogFile="changelog.xml" \
  history

echo "↩️ ------------------------------------------------------------->> Rolling back to tag: $ROLLBACK_TAG"
echo
"$LIQUIBASE_BIN" \
  --driver=oracle.jdbc.OracleDriver \
  --url="$DB_URL" \
  --username="$DB_USER" \
  --password="$DB_PASS" \
  --changeLogFile="changelog.xml" \
  rollback "$ROLLBACK_TAG"

echo "📜 ------------------------------------------------------------->> History after rollback"
echo
"$LIQUIBASE_BIN" \
  --driver=oracle.jdbc.OracleDriver \
  --url="$DB_URL" \
  --username="$DB_USER" \
  --password="$DB_PASS" \
  --changeLogFile="changelog.xml" \
  history


echo
echo "✅ liquibase-rollback.sh completed"



