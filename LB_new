run-liquibase.sh
#!/bin/sh
set -euo pipefail

echo "============================================================================================================================="
echo "============================================     Starting run-liquibase.sh      ============================================="
echo "============================================================================================================================="


ENVIRONMENT=${ENVIRONMENT:-}
DATABASE_URL=${DATABASE_URL:-}
CHANGEREQUEST_ID=${CHANGEREQUEST_ID:-}
OPERATION=${OPERATION:-}
ROLLBACK_TAG=${ROLLBACK_TAG:-}

# ------------------------------
# Validate ENVIRONMENT
# ------------------------------
if [ -z "$ENVIRONMENT" ]; then
  printf "ERROR: ENVIRONMENT is required (uat/prod)\n" >&2
  sleep 0.1
  exit 1
fi

ENV_LOWER=$(printf '%s' "$ENVIRONMENT" | awk '{print tolower($0)}')
ENV_UPPER=$(printf '%s' "$ENVIRONMENT" | awk '{print toupper($0)}')

# ------------------------------
# Validate OPERATION
# ------------------------------
if [ -z "$OPERATION" ]; then
  printf "ERROR: OPERATION is required (update/rollback)\n" >&2
  sleep 0.1
  exit 1
fi

OPERATION_LOWER=$(printf '%s' "$OPERATION" | awk '{print tolower($0)}')

if [ "$OPERATION_LOWER" != "update" ] && [ "$OPERATION_LOWER" != "rollback" ]; then
  printf "ERROR: Invalid OPERATION: %s\n" "$OPERATION" >&2
  printf "HINT: Must be either update or rollback\n" >&2
  sleep 0.1
  exit 1
fi

# ------------------------------
# Validate DATABASE_URL
# ------------------------------
if [ -z "$DATABASE_URL" ]; then
  printf "ERROR: DATABASE_URL is required\n" >&2
  sleep 0.1
  exit 1
fi

echo
echo "User Paased Environment Variables through GoCD Pipeline: execution in run-liquibase.sh"
echo
echo "ENVIRONMENT: $ENV_LOWER"
echo "DATABASE_URL: $DATABASE_URL"
echo "OPERATION: $OPERATION"

# ==================================================================
# STRICT IPv4 VALIDATION
# ==================================================================
HOST_PART=$(printf '%s\n' "$DATABASE_URL" | sed -n 's/.*@\/\/\([^:\/]*\).*/\1/p')

if [ -z "$HOST_PART" ]; then
  printf "ERROR: Could not extract DB host from DATABASE_URL: %s\n" "$DATABASE_URL" >&2
  sleep 0.1
  exit 1
fi

# Ensure IPv4 format only
if ! printf '%s' "$HOST_PART" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
  printf "ERROR: Host '%s' is not a valid IPv4 address.\n" "$HOST_PART" >&2
  printf "HINT: Do NOT use hostname. Use IP like:\n" >&2
  printf "  jdbc:oracle:thin:@//10.2.2.12:1521/ORCL\n" >&2
  sleep 0.1
  exit 1
fi

DB_IP="$HOST_PART"
DB_IP_UNDERSCORE=$(printf '%s' "$DB_IP" | tr '.' '_')

echo
echo "Extracted and Normalised DB IP:"
echo "DB_IP: $DB_IP"
echo "DB_IP_UNDERSCORE: $DB_IP_UNDERSCORE"
echo

# ------------------------------
# Resolve Credentials
# ------------------------------
DB_USER_VAR="${ENV_UPPER}_${DB_IP_UNDERSCORE}_DATABASE_USERNAME"
DB_PASS_VAR="${ENV_UPPER}_${DB_IP_UNDERSCORE}_DATABASE_PASSWORD"

DB_USER=$(printenv "$DB_USER_VAR" || true)
DB_PASS=$(printenv "$DB_PASS_VAR" || true)

if [ -z "$DB_USER" ] || [ -z "$DB_PASS" ]; then
  printf "ERROR: Missing credentials for DB host %s\n" "$DB_IP" >&2
  printf "Make sure Database credentials defined/configured in Pipeline secure Variables for DB host %s\n" "$DB_IP" >&2
  printf "Expected environment variables:\n" >&2
  printf "  %s\n" "$DB_USER_VAR" >&2
  printf "  %s\n" "$DB_PASS_VAR" >&2
  sleep 0.1
  exit 1
fi

echo "Using credentials: $DB_USER_VAR"

# ------------------------------
# Base dirs + Docker Image
# ------------------------------
LIQUIBASE_BASE_DIR=$(pwd)
DATABASES_DIR="$LIQUIBASE_BASE_DIR/../databases"
LIQUIBASE_DOCKER_IMAGE="artifactory.idfcfirstbank.com/etoll-docker/optimus-library/liquibase_alpine:4.21.0-r0"

# ------------------------------
# Validate Artifactory credentials
# ------------------------------
if [ -z "${ARTIFACTORY_USERNAME:-}" ] || [ -z "${ARTIFACTORY_PASSWORD:-}" ]; then
  printf "ERROR: ARTIFACTORY_USERNAME and ARTIFACTORY_PASSWORD are required\n" >&2
  sleep 0.1
  exit 1
fi


echo "$ARTIFACTORY_PASSWORD" | docker login artifactory.idfcfirstbank.com  --username "$ARTIFACTORY_USERNAME" --password-stdin  2>/dev/null

echo "Running Liquibase docker container..."

if [ "$OPERATION_LOWER" = "rollback" ]; then
  echo "Running rollback operation inside Docker container"
  docker run --rm \
    --workdir /liquibase_scripts \
    -e DB_URL="$DATABASE_URL" \
    -e CHANGEREQUEST_ID="$CHANGEREQUEST_ID" \
    -e DB_USER="$DB_USER" \
    -e DB_PASS="$DB_PASS" \
    -e DB_IP_UNDERSCORE="$DB_IP_UNDERSCORE" \
    -e ROLLBACK_TAG="$ROLLBACK_TAG" \
    -v "$DATABASES_DIR:/liquibase/databases:ro" \
    -v "$LIQUIBASE_BASE_DIR:/liquibase_scripts:ro" \
    "$LIQUIBASE_DOCKER_IMAGE" /bin/sh -c "
      sh /liquibase_scripts/liquibase-rollback.sh \"$ENV_LOWER\"
    "
else
  echo "Running update operation inside Docker container"
  docker run --rm \
    --workdir /liquibase_scripts \
    -e DB_URL="$DATABASE_URL" \
    -e CHANGEREQUEST_ID="$CHANGEREQUEST_ID" \
    -e DB_USER="$DB_USER" \
    -e DB_PASS="$DB_PASS" \
    -e DB_IP_UNDERSCORE="$DB_IP_UNDERSCORE" \
    -v "$DATABASES_DIR:/liquibase/databases:ro" \
    -v "$LIQUIBASE_BASE_DIR:/liquibase_scripts:ro" \
    "$LIQUIBASE_DOCKER_IMAGE" /bin/sh -c "
      sh /liquibase_scripts/liquibase-wrapper.sh \"$ENV_LOWER\"
    "
fi

echo "run-liquibase.sh completed successfully"
